    {
      "id": "LAovmn8IfAF0Cc1GJelF6",
      "type": "text",
      "x": -769.0203006081044,
      "y": -671.7447631415606,
      "width": 316.22334966376786,
      "height": 234.35735958917587,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "DPMSaFxJfzyQvDjnKWKsd"
      ],
      "frameId": null,
      "index": "a28",
      "roundness": null,
      "seed": 930661512,
      "version": 1429,
      "versionNonce": 981758395,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "2-8rXXIbnPfYVOJ0ntHJB",
          "type": "arrow"
        }
      ],
      "updated": 1795546955703,
      "link": null,
      "locked": false,
      "text": "The complet mental model of the entire\nlifecycle accurately:\n\n* argparse.ArgumentParser(): initializes the\nparser engine itself.\n\n* parser.add_argument(): defines the\nschema—registering expected flags/positionals,\ntypes, defaults, and constraints.\n\n* parser.parse_args(): slices `sys.argv[1:]`,\nruns the validation and type conversions\nagainst your schema, and returns a `Namespace`\nobject with the attributes resolved from your\n`dest`, positional names, or flags.",
      "fontSize": 12.499059178089379,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The complet mental model of the entire lifecycle accurately:\n\n* argparse.ArgumentParser(): initializes the parser engine itself.\n\n* parser.add_argument(): defines the schema—registering expected flags/positionals, types, defaults, and constraints.\n\n* parser.parse_args(): slices `sys.argv[1:]`, runs the validation and type conversions against your schema, and returns a `Namespace` object with the attributes resolved from your `dest`, positional names, or flags.",
      "autoResize": false,
      "lineHeight": 1.25
    },
