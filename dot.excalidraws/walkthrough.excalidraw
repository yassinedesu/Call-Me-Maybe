      "link": null,
      "locked": false,
      "text": "• registry.py validates JSON\n  into dict[str, FunctionSpec]\n• prompt.py builds ChatML:\n  <|im_start|>system ...\\n\n  <|im_start|>user\\n\n  What is the sum of 2 and 3?\n  <|im_end|>\\n<|im_start|>assistant\\n\n• Python appends '{\"name\":\"'",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• registry.py validates JSON\n  into dict[str, FunctionSpec]\n• prompt.py builds ChatML:\n  <|im_start|>system ...\\n\n  <|im_start|>user\\n\n  What is the sum of 2 and 3?\n  <|im_end|>\\n<|im_start|>assistant\\n\n• Python appends '{\"name\":\"'",
      "lineHeight": 1.25,
      "index": "aG",
      "autoResize": true
    },
