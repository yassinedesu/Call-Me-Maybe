      "updated": 1794769811304,
      "link": null,
      "locked": false,
      "text": "• encode(str) -> Tensor[1, n]  | Always unwrap via [0].tolist() -> list[int]\n• decode(list[int]) -> str     | Converts token IDs back to text\n• get_logits_from_input_ids(list[int]) -> list[float] (full forward pass)\n• get_path_to_vocab_file() -> str (path to vocab.json: token_str -> id)\n• Idiom: encode(ch)[0].tolist()[-1] grabs trailing token past BPE space 'Ġ'",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• encode(str) -> Tensor[1, n]  | Always unwrap via [0].tolist() -> list[int]\n• decode(list[int]) -> str     | Converts token IDs back to text\n• get_logits_from_input_ids(list[int]) -> list[float] (full forward pass)\n• get_path_to_vocab_file() -> str (path to vocab.json: token_str -> id)\n• Idiom: encode(ch)[0].tolist()[-1] grabs trailing token past BPE space 'Ġ'",
      "lineHeight": 1.25,
      "index": "aC",
      "autoResize": true
    },
