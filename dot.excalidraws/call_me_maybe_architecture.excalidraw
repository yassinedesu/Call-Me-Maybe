    },
    {
      "id": "d8845d8e-89a",
      "type": "text",
      "x": 60,
      "y": 652,
      "width": 427.18,
      "height": 315.90000000000003,
      "angle": 0,
      "strokeColor": "#e2e8f0",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 54093,
      "version": 2,
      "versionNonce": 286148013,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794775884821,
      "link": null,
      "locked": false,
      "text": "SDK Interface (llm_sdk.Small_LLM_Model):\n• Model: Qwen/Qwen3-0.6B (~151,936 vocab tokens)\n• encode(str) -> Tensor [1, n] -> [0].tolist()\n• get_logits_from_input_ids(list[int]) -> list[float]\n• decode(list[int]) -> str\n• get_path_to_vocab_file() -> vocab.json\n\nAllow-List Masking (Name, Boolean, Number):\n  masked = [-math.inf] * len(logits)\n  for tok_id in allowed_tokens:\n      masked[tok_id] = logits[tok_id]\n  next_id = masked.index(max(masked))\n\nBan-List Masking (String):\n  masked = list(logits)\n  for tok_id in banned_strings:\n      masked[tok_id] = -math.inf\n  next_id = masked.index(max(masked))",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SDK Interface (llm_sdk.Small_LLM_Model):\n• Model: Qwen/Qwen3-0.6B (~151,936 vocab tokens)\n• encode(str) -> Tensor [1, n] -> [0].tolist()\n• get_logits_from_input_ids(list[int]) -> list[float]\n• decode(list[int]) -> str\n• get_path_to_vocab_file() -> vocab.json\n\nAllow-List Masking (Name, Boolean, Number):\n  masked = [-math.inf] * len(logits)\n  for tok_id in allowed_tokens:\n      masked[tok_id] = logits[tok_id]\n  next_id = masked.index(max(masked))\n\nBan-List Masking (String):\n  masked = list(logits)\n  for tok_id in banned_strings:\n      masked[tok_id] = -math.inf\n  next_id = masked.index(max(masked))",
      "lineHeight": 1.25,
      "index": "ag",
      "autoResize": true
    },
