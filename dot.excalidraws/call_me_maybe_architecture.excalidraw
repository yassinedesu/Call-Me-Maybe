      "text": "Prompt: \"What is the sum of 2 and 3?\"\n\n[Python]  <|im_start|>system ... assistant\\n{\"name\":\"\n[Model ]  fn  _add  _numbers  \"          (Trie mask)\n[Python]  , \"parameters\": {\"a\": \n[Model ]  2  ,                           (Num mask)\n[Python]  , \"b\": \n[Model ]  3  }                           (Num mask)\n[Python]  json.dump() -> {\"a\": 2.0, \"b\": 3.0}",
