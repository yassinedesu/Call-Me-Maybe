      "isDeleted": false,
      "boundElements": [],
      "updated": 1794775884821,
      "link": null,
      "locked": false,
      "text": "   • Scans vocab.json and bans tokens containing '\"', '\\n', '\\r', or curly quotes.\n   • Ensures string cannot prematurely break JSON syntax (keeps close_hammer '\"' allowed).",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "   • Scans vocab.json and bans tokens containing '\"', '\\n', '\\r', or curly quotes.\n   • Ensures string cannot prematurely break JSON syntax (keeps close_hammer '\"' allowed).",
      "lineHeight": 1.25,
      "index": "aw",
      "autoResize": true
    },
