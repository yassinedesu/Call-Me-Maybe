      "boundElements": [],
      "updated": 1794775884821,
      "link": null,
      "locked": false,
      "text": "   • Identifies tokens with '{', '}', '\\'', '.', '\\\\', '\\n', or schema words ('regex', 'replacement', 'source_string').\n   • Not hard-masked; if chosen after >=1 token, loop breaks cleanly to stop schema drift.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "   • Identifies tokens with '{', '}', '\\'', '.', '\\\\', '\\n', or schema words ('regex', 'replacement', 'source_string').\n   • Not hard-masked; if chosen after >=1 token, loop breaks cleanly to stop schema drift.",
      "lineHeight": 1.25,
      "index": "ay",
      "autoResize": true
    },
