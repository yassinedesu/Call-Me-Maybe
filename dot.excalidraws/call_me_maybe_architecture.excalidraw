      "boundElements": [],
      "updated": 1794775884821,
      "link": null,
      "locked": false,
      "text": "   • Pipeline cleans output via raw_value.replace('\\\\\\\\', '\\\\').strip().\n   • Tradeoff: Drift set bans '.' and '\\\\', which can truncate complex regex arguments early.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "   • Pipeline cleans output via raw_value.replace('\\\\\\\\', '\\\\').strip().\n   • Tradeoff: Drift set bans '.' and '\\\\', which can truncate complex regex arguments early.",
      "lineHeight": 1.25,
      "index": "b02",
      "autoResize": true
    },
