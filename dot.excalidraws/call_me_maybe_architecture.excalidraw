      "boundElements": [],
      "updated": 1794775884821,
      "link": null,
      "locked": false,
      "text": "1. Python injects prefix:\n   prompt + '{\"name\":\"'\n2. Encode to working_ids\n3. Call select_function_name():\n   • Trie walk over registered names\n   • Model logits pick surviving branch\n   • Halts on closure quote '\"'\n4. Lookup spec = registry[name]",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Python injects prefix:\n   prompt + '{\"name\":\"'\n2. Encode to working_ids\n3. Call select_function_name():\n   • Trie walk over registered names\n   • Model logits pick surviving branch\n   • Halts on closure quote '\"'\n4. Lookup spec = registry[name]",
      "lineHeight": 1.25,
      "index": "aQ",
      "autoResize": true
    },
