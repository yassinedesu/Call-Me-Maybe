      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 allowed_ids: tokens for '0123456789-.'\n\u2022 stop_ids: tokens for '}' and ','\n\u2022 Loops up to max_digits=20\n\u2022 Breaks when model emits '}' or ','\n\u2022 Cast to float() or int(float()) in pipeline",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 allowed_ids: tokens for '0123456789-.'\n\u2022 stop_ids: tokens for '}' and ','\n\u2022 Loops up to max_digits=20\n\u2022 Breaks when model emits '}' or ','\n\u2022 Cast to float() or int(float()) in pipeline",
      "lineHeight": 1.25
