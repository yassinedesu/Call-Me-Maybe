      "text": "1. Hard Ban-List (_load_banned_string_tokens):",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Hard Ban-List (_load_banned_string_tokens):",
      "lineHeight": 1.25
    },
    {
      "id": "3843e4f9-cfa",
      "type": "text",
      "x": 1368,
      "y": 672,
      "width": 725.4,
      "height": 35.1,
      "angle": 0,
      "strokeColor": "#451a03",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 7269,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "   \u2022 Scans vocab.json and bans tokens containing '\"', '\\n', '\\r', or curly quotes.\n   \u2022 Ensures string cannot prematurely break JSON syntax (keeps close_hammer '\"' allowed).",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "   \u2022 Scans vocab.json and bans tokens containing '\"', '\\n', '\\r', or curly quotes.\n   \u2022 Ensures string cannot prematurely break JSON syntax (keeps close_hammer '\"' allowed).",
      "lineHeight": 1.25
    },
    {
      "id": "d21e2e87-0e8",
      "type": "text",
      "x": 1368,
      "y": 725,
      "width": 503.44,
      "height": 18.900000000000002,
