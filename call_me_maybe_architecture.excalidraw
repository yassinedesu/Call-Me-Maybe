      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 Single forward pass (no loop)\n\u2022 Finds true_id & false_id via encode()[-1]\n\u2022 Masks all ~151k other tokens to -inf\n\u2022 Compares logits[true_id] vs logits[false_id]\n\u2022 Returns Python bool (True / False)",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 Single forward pass (no loop)\n\u2022 Finds true_id & false_id via encode()[-1]\n\u2022 Masks all ~151k other tokens to -inf\n\u2022 Compares logits[true_id] vs logits[false_id]\n\u2022 Returns Python bool (True / False)",
      "lineHeight": 1.25
    },
