      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "2. Soft Drift Terminators (_load_structural_drift_tokens):",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Soft Drift Terminators (_load_structural_drift_tokens):",
      "lineHeight": 1.25
    },
    {
      "id": "b3eecfe4-e5a",
      "type": "text",
      "x": 1368,
      "y": 749,
      "width": 959.14,
      "height": 35.1,
      "angle": 0,
      "strokeColor": "#451a03",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
