      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "   \u2022 Pipeline cleans output via raw_value.replace('\\\\\\\\', '\\\\').strip().\n   \u2022 Tradeoff: Drift set bans '.' and '\\\\', which can truncate complex regex arguments early.",
