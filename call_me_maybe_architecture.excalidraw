      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "   \u2022 Identifies tokens with '{', '}', '\\'', '.', '\\\\', '\\n', or schema words ('regex', 'replacement', 'source_string').\n   \u2022 Not hard-masked; if chosen after >=1 token, loop breaks cleanly to stop schema drift.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "   \u2022 Identifies tokens with '{', '}', '\\'', '.', '\\\\', '\\n', or schema words ('regex', 'replacement', 'source_string').\n   \u2022 Not hard-masked; if chosen after >=1 token, loop breaks cleanly to stop schema drift.",
      "lineHeight": 1.25
    },
