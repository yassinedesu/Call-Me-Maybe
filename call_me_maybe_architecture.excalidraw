    {
      "id": "b4d0678b-7f9",
      "type": "text",
      "x": 1285,
      "y": 305,
      "width": 322.4,
      "height": 157.95000000000002,
      "angle": 0,
      "strokeColor": "#052e16",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 12112,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "1. Python injects: '\", \"parameters\": {'\n2. For each (param, info) in spec:\n   \u2022 Inject key: '\"<param>\": '\n   \u2022 Dispatch by param_info['type']:\n     - boolean -> select_boolean_value\n     - number/int -> select_number_value\n     - string -> select_string_value\n   \u2022 Inject ', ' between parameters\n3. Re-encode ratchet keeps BPE canonical",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Python injects: '\", \"parameters\": {'\n2. For each (param, info) in spec:\n   \u2022 Inject key: '\"<param>\": '\n   \u2022 Dispatch by param_info['type']:\n     - boolean -> select_boolean_value\n     - number/int -> select_number_value\n     - string -> select_string_value\n   \u2022 Inject ', ' between parameters\n3. Re-encode ratchet keeps BPE canonical",
      "lineHeight": 1.25
    },
